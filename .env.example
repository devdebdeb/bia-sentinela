# Copie para .env e preencha. NUNCA versione o .env real (ja esta no .gitignore).
# As chaves sao lidas do ambiente; jamais sao logadas nem commitadas.

# --- Provedor de LLM ---------------------------------------------------------
# "openai" cobre qualquer endpoint compativel (Groq, Gemini, Ollama, OpenRouter).
# "anthropic" usa a SDK paga. "fake" e o caminho offline (sem rede).
BIA_LLM_PROVIDER=openai

# --- Opcao A: Groq (gratis, sem cartao) — DEFAULT ----------------------------
# Crie a chave em https://console.groq.com  (Settings -> API Keys).
BIA_OPENAI_API_KEY=
BIA_OPENAI_BASE_URL=https://api.groq.com/openai/v1
BIA_OPENAI_MODEL=llama-3.3-70b-versatile

# --- Opcao B: Ollama local (offline, sem chave) ------------------------------
# Instale em https://ollama.com, rode `ollama pull qwen2.5:32b` e `ollama serve`.
# qwen2.5:32b cabe inteiro em GPUs de 24GB e tem tool calling forte. Em GPUs
# menores use qwen2.5:14b ou llama3.1:8b. Depois troque as 3 linhas acima por:
#   BIA_OPENAI_API_KEY=ollama          (qualquer valor nao-vazio; o Ollama ignora)
#   BIA_OPENAI_BASE_URL=http://localhost:11434/v1
#   BIA_OPENAI_MODEL=qwen2.5:32b

# --- Opcao C: Google Gemini (free tier, sem cartao) --------------------------
# Chave no Google AI Studio (https://aistudio.google.com).
#   BIA_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   BIA_OPENAI_MODEL=gemini-2.0-flash

# --- Opcao D: Anthropic (pago) -----------------------------------------------
#   BIA_LLM_PROVIDER=anthropic
#   BIA_ANTHROPIC_API_KEY=
#   BIA_MODEL=claude-sonnet-4-6

# --- Geral -------------------------------------------------------------------
BIA_LOG_LEVEL=INFO
BIA_LOG_REDACT_PII=true
BIA_SEED=42
